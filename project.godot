[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lookey"
run/main_scene="uid://58kg5u3rdfjd"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SimpleGrass="*uid://bfq0snth8sj3h"

[display]

window/size/viewport_width=1500
window/size/viewport_height=1200
window/size/resizable=false

[editor_plugins]

enabled=PackedStringArray("res://addons/simplegrasstextured/plugin.cfg")

[global_group]

camera_player=""

